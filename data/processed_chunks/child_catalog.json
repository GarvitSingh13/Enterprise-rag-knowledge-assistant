    "parent_id": "97a0d167-457d-44b9-8d52-2ce4dc822a01",
    "content": "Access is restricted strictly to C-Suite Officers (CEO, CFO, CTO) and Members of the Board of Directors. ## 2.",
    "chunk_type": "child",
    "chunk_index": 1,
    "metadata": {
