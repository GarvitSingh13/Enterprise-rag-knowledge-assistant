    "character_count": 182,
    "estimated_token_count": 45
  },
  {
    "id": "e859692b-9c9e-45f9-a449-2e3ec8c5e29a",
    "parent_id": "7f645fc2-4134-4b47-ad5a-7597d967d5b6",
    "content": "## 3. Automated Rollback Triggers\nAn automated rollback to the previous stable release hash is triggered immediately if:\n- HTTP 5xx error rate spikes above 0.5% over a 3-minute rolling window.",
    "chunk_type": "child",
    "chunk_index": 4,
    "metadata": {
      "doc_id": "abb01241-a73d-4986-a395-6787774771c3",
      "title": "Engineering API Deployment SOP",
      "department": "engineering",
      "clearance_level": "internal",
      "document_type": "sop",
      "author": "DevOps Architecture Team",
      "version": "1.0.0",
      "created_date": "2026-10-18",
      "tags": [
