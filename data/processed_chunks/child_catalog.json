    "parent_id": "5e4e7e2f-fdcd-4bf6-8ab0-b798dfeb4ef7",
    "content": "Access is restricted strictly to C-Suite Officers (CEO, CFO, CTO) and Members of the Board of Directors. ## 2.",
    "chunk_type": "child",
    "chunk_index": 1,
    "metadata": {
      "doc_id": "09f113d8-1ab0-45ae-845a-26d47801b4bc",
