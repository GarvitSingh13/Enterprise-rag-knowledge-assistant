      ],
      "extra_attributes": {}
    },
    "character_count": 276,
    "estimated_token_count": 69
  },
  {
    "id": "d5397f37-83c3-4de9-ad85-06f6b8afc8fd",
    "parent_id": "a96d2cd9-92e8-4fb3-93ef-843590fd4f23",
    "content": "- Maximum outperformance (125%+ ARR target): 200% target payout cap. ## 3.",
    "chunk_type": "child",
    "chunk_index": 3,
    "metadata": {
      "doc_id": "b711527f-48c7-4f91-b60f-e98f9e0c505d",
