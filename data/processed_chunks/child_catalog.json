  {
    "id": "3fd359d4-df2c-4d22-adf6-854ce9e18a31",
    "parent_id": "8faa78a2-8913-464c-96e9-e1566ba2f6f9",
    "content": "- The Kubernetes readiness probe fails for more than 3 consecutive retries on more than 20% of pods. - Latency P95 exceeds 500ms for more than 5 continuous minutes. Rollback command:\n`kubectl rollout undo deployment/api-gateway -n production`",
    "chunk_type": "child",
    "chunk_index": 5,
    "metadata": {
