    "parent_id": "ee687f53-ebc9-48d3-8533-d6c04848edd0",
    "content": "Access is restricted strictly to C-Suite Officers (CEO, CFO, CTO) and Members of the Board of Directors. ## 2.",
    "chunk_type": "child",
    "chunk_index": 1,
    "metadata": {
      "doc_id": "9a8f24c0-f8aa-46ad-be98-7b7196facc70",
