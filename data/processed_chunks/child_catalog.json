    "parent_id": "c63a5c0d-a7a7-470c-9dcc-22f3ff60a6d0",
    "content": "Access is restricted strictly to C-Suite Officers (CEO, CFO, CTO) and Members of the Board of Directors. ## 2.",
    "chunk_type": "child",
    "chunk_index": 1,
    "metadata": {
      "doc_id": "bf29965e-2f7b-42ec-91ca-52e41a8ea94d",
