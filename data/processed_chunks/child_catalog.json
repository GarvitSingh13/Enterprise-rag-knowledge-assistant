      ],
      "extra_attributes": {}
    },
    "character_count": 182,
    "estimated_token_count": 45
  },
  {
    "id": "233007b9-caa8-44aa-b02d-edb537123f18",
    "parent_id": "a2bd8b6f-53e7-4e4a-abfb-afeb5c348f76",
    "content": "## 3. Automated Rollback Triggers\nAn automated rollback to the previous stable release hash is triggered immediately if:\n- HTTP 5xx error rate spikes above 0.5% over a 3-minute rolling window.",
    "chunk_type": "child",
    "chunk_index": 4,
    "metadata": {
      "doc_id": "724461fc-4313-4706-a0a2-1662c66c4d2e",
      "title": "Engineering API Deployment SOP",
      "department": "engineering",
