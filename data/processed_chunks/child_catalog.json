        "deployment",
        "kubernetes",
        "api",
        "sop",
        "engineering",
        "internal"
      ],
      "source_file": "api_deployment_sop.md",
      "allowed_roles": [
        "employee",
        "manager",
        "admin",
        "executive"
      ],
      "extra_attributes": {}
    },
    "character_count": 226,
    "estimated_token_count": 56
  },
  {
    "id": "d56bc75e-1e4a-45fa-8c6d-b95684d74524",
    "parent_id": "6ad87424-3859-4ef9-bde2-8d7f0d709e53",
    "content": "Prior to initiating a deployment:\n- All unit tests must achieve a minimum of 85% branch coverage. - Vulnerability scans must report zero critical or high severity CVEs. - Load testing must confirm P99 latency remains under 200ms at 1,500 RPS. ## 2.",
    "chunk_type": "child",
    "chunk_index": 1,
    "metadata": {
      "doc_id": "0ae5ccea-2c14-4d7b-a608-dc60aa0b4043",
