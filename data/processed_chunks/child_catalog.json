      "extra_attributes": {}
    },
    "character_count": 226,
    "estimated_token_count": 56
  },
  {
    "id": "cfef6871-3650-417d-96e6-ca97069f9913",
    "parent_id": "d979dabf-8f45-40b3-9658-dcf6fcfcfe7c",
    "content": "Prior to initiating a deployment:\n- All unit tests must achieve a minimum of 85% branch coverage. - Vulnerability scans must report zero critical or high severity CVEs. - Load testing must confirm P99 latency remains under 200ms at 1,500 RPS. ## 2.",
    "chunk_type": "child",
    "chunk_index": 1,
    "metadata": {
      "doc_id": "2e107649-5b2e-4e59-91e2-77431e85833a",
