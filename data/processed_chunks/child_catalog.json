    "parent_id": "bd3de297-69c8-4ef0-ad61-1b7bbd0f811c",
    "content": "Access is restricted strictly to C-Suite Officers (CEO, CFO, CTO) and Members of the Board of Directors. ## 2.",
    "chunk_type": "child",
    "chunk_index": 1,
    "metadata": {
      "doc_id": "0b0dfa0c-0407-4426-acdf-bf5c9eab5e52",
