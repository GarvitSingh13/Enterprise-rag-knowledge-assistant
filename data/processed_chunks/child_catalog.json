      "version": "1.0.0",
      "created_date": "2026-10-18",
      "tags": [
        "restricted",
        "documentation",
        "executive",
        "compensation",
        "board"
      ],
      "source_file": "executive_compensation_restricted.md",
      "allowed_roles": [
