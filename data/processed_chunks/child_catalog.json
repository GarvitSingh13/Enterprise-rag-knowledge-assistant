    "parent_id": "a96d2cd9-92e8-4fb3-93ef-843590fd4f23",
    "content": "Access is restricted strictly to C-Suite Officers (CEO, CFO, CTO) and Members of the Board of Directors. ## 2.",
    "chunk_type": "child",
    "chunk_index": 1,
    "metadata": {
      "doc_id": "b711527f-48c7-4f91-b60f-e98f9e0c505d",
